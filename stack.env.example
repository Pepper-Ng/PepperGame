APP_NAME=PepperGame
APP_ENV=production
# Leave APP_KEY empty on first deploy to let the container generate and persist it.
APP_KEY=
APP_DEBUG=false
LOG_LEVEL=error
APP_URL=https://peppergame.example.com

HTTP_PORT=8080
HTTPS_PORT=8443

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=change-this-database-password

CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=720
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=PepperGame

REVERB_APP_ID=peppergame
REVERB_APP_KEY=change-this-reverb-key
REVERB_APP_SECRET=change-this-reverb-secret
REVERB_HOST=peppergame.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_PORT=8090